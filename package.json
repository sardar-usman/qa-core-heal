{
  "name": "qa-core-heal",
  "version": "0.7.0",
  "description": "Deterministic selector healing for Playwright, Cypress, and Selenium specs. No LLM, no API key.",
  "keywords": [
    "playwright",
    "playwright-test",
    "cypress",
    "selenium",
    "mocha",
    "self-healing",
    "self-healing-tests",
    "locator",
    "selector",
    "flaky-tests",
    "test-automation",
    "e2e",
    "end-to-end-testing",
    "testing",
    "qa",
    "deterministic",
    "no-llm",
    "cli"
  ],
  "homepage": "https://github.com/sardar-usman/qa-core-heal#readme",
  "bugs": {
    "url": "https://github.com/sardar-usman/qa-core-heal/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sardar-usman/qa-core-heal.git"
  },
  "author": {
    "name": "Muhammad Usman",
    "url": "https://sardarusmanjutt.com"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.6"
  },
  "bin": {
    "qa-core-heal": "dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "skill",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "heal": "npm run build && node dist/cli.js",
    "demo": "npm run build && node example-project/scripts/demo.mjs",
    "evals": "npm run build && node evals/run-evals.mjs",
    "test": "npm run build && node --import ./tests/helpers/temps.mjs --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.49.0",
    "playwright": ">=1.49.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/node": "^22.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^17.4.2",
    "playwright": "1.60.0",
    "typescript": "^5.6.0"
  }
}
